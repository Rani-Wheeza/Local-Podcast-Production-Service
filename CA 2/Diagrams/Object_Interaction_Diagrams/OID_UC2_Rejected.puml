@startuml OID_UC2_Rejected
title Interaction diagram - UC2 recordDecision: rejected
hide footbox

' Section A, UC2 alternatives (Arno). This diagram agrees with CO4, the Section A CRC cards (#28) and GRASP (#32).
' Language of notes and messages: ASD-STE100 Simplified Technical English.
' Scenario: GS13 Proposal editor rejects a proposal
actor ":Proposal Editor" as PE
participant ":ProposalController" as PCtl
participant ":ProposalRepository" as Repo
participant ":Clock" as Clk
participant "p : Proposal" as P
participant "latest : ProposalDecision" as L
participant "d : ProposalDecision" as D

PE -> PCtl : recordDecision(proposal, rejected, conditions, note)
activate PCtl
PCtl -> Repo : p = find(proposal)
PCtl -> Clk : today = currentDate()
note right of PCtl
  editor = the signed-in Proposal Editor (the actor).
  Section A must give the source of editor (R3).
end note
PCtl -> P : result = recordDecision(rejected, editor, today, conditions, note)
activate P
P -> P : allowed = canRecordDecision()
activate P
opt p has an earlier decision
  P -> L : open = leavesProposalOpen()
  note right of L : The answer is true if the latest\noutcome is "returned" or "held".
end
deactivate P
note over P : allowed = true. OID_UC2_AlreadyDecided\nshows allowed = false.
P -> D ** : create(rejected, editor, today, conditions, note)
note right of D
  decisionDate = today. decidedBy = editor.
  The earlier decisions do not change (CO4).
end note
P --> PCtl : recorded
deactivate P
PCtl -> Repo : save(p)
PCtl -> P : state = currentState()
P --> PCtl : rejected
PCtl --> PE : The system shows the proposal as rejected.\nIt shows the reason, the editor name and the date (GS13).
deactivate PCtl
@enduml
